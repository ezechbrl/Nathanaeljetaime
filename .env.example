# Voir docs/CLES-ET-COMPTES.md pour savoir où trouver chaque valeur.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_MODE=mock            # mock = démo sans back-end ; live = vrai back-end
NEXT_PUBLIC_LAUNCH_MODE=waitlist     # waitlist = liste d'attente ; open = inscriptions ouvertes
ENCRYPTION_KEY=                      # 32 octets en base64
CRON_SECRET=

# Supabase (base de données + connexion)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA
ANTHROPIC_API_KEY=
FAL_KEY=                             # optionnel : génération d'images

# Shopify (app publique)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
NEXT_PUBLIC_SHOPIFY_API_KEY=         # même valeur que SHOPIFY_API_KEY (lien d'activation des couleurs)
NEXT_PUBLIC_SHOPIFY_REFERRAL_URL=    # facultatif : ton lien d'affilié Shopify

# Paiement par Shopify (Shopify App Pricing)
SHOPIFY_APP_HANDLE=                  # ex. vitrio
SHOPIFY_APP_ID=                      # nombre dans l'URL de l'app, Partner Dashboard
SHOPIFY_PARTNER_ORG_ID=              # nombre dans l'URL du Partner Dashboard
SHOPIFY_PARTNER_TOKEN=               # Partner API client (permissions : Manage apps, View financials)

# Stripe : plus utilisé (le paiement passe par Shopify), gardé pour une éventuelle version hors Shopify
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=

# E-mails (optionnel)
RESEND_API_KEY=
CONTACT_EMAIL=

# Mentions légales (éditeur du site) : affichées sur /legal/mentions-legales
LEGAL_NAME=                          # nom et prénom du ou de la titulaire
LEGAL_FORM=                          # ex. entrepreneur individuel
LEGAL_ADDRESS=                       # adresse complète
LEGAL_SIRET=                         # numéro SIRET (14 chiffres)
LEGAL_VAT=                           # vide = « TVA non applicable, art. 293 B du CGI »
